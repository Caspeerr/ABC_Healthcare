# Copy this file to .env for local testing, or set these as real
# environment variables / EC2 user-data exports in the actual deployment.
# In production these values come from the RDS instance Terraform creates,
# not from a committed file.

PORT=3000
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=abc_healthcare

# Optional for local testing - protects /api/patients with HTTP Basic
# Auth, same as production. Leave both unset to run /api unprotected
# locally (a loud warning is logged on startup when you do this).
API_AUTH_USER=abchealthcare
API_AUTH_PASSWORD=changeme
