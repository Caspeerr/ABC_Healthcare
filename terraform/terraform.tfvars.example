# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit real account/subnet IDs.

aws_region    = "ap-south-1"
project_name  = "abc-healthcare"

# Find these in the AWS Console: VPC -> Your VPCs (the default VPC),
# and VPC -> Subnets (filter by that VPC ID).
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx"
]

# One of the subnet_ids above - where the backend EC2 instance launches.
ec2_subnet_id = "subnet-xxxxxxxxxxxxxxxxx"
